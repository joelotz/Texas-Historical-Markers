<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Ochiltree County — Unmapped Historical Markers</name>
  <description>THC markers in Ochiltree County without an HMDB id (isMissing excluded). 1 with THC coords; 0 geocoded from address; 0 omitted (no usable address). Orange pins are isPending=True — the marker may not be installed yet.</description>
  <Style id="normal">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/red-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="pending">
    <IconStyle>
      <color>ff00a5ff</color>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/orange-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Placemark>
    <name>First Sanitarium</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[221 S. Baylor, Perryton<br/><br/><b>Address:</b> 221 S Baylor, Parryton<br/><br/><b>Marker Text:</b> --]]></description>
    <Point><coordinates>-100.80898,36.396532,0</coordinates></Point>
  </Placemark>
</Document>
</kml>
