<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Oldham County — Unmapped Historical Markers</name>
  <description>THC markers in Oldham County without an HMDB id (isMissing excluded). 1 with THC coords; 0 geocoded from address; 1 omitted (no usable address). Orange pins are isPending=True — the marker may not be installed yet.</description>
  <Style id="normal">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/red-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="pending">
    <IconStyle>
      <color>ff00a5ff</color>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/orange-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Placemark>
    <name>Ft. Smith-Santa Fe Trail</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[<b>Address:</b> Vega]]></description>
    <Point><coordinates>-102.397082739421,35.2902303702661,0</coordinates></Point>
  </Placemark>
</Document>
</kml>
