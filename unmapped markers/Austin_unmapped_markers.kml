    <name>St. James Lutheran Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 10362 New Wehdem Rd, Brenham<br/><br/><b>Marker Text:</b> marker pending]]></description>
