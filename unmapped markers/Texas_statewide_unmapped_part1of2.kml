  <Placemark>
    <name>Hendrick Arnold</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[Straus-Medina Ranch, Arnold Cemetery<br/><br/><b>Address:</b> Straus-Medina Road, San Antonio<br/><br/><b>County:</b> Bexar<br/><br/><b>Marker Text:</b> Participated in the capture of Bexar, December 5 to 10 1835 - - - Born in Kentucky 1804 - Died November 9, 1849 Erected by the State of Texas 1936]]></description>
