  <Placemark>
    <name>Decker House</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[Corner of Britton and Water Streets, Rio Grande City. Not Located<br/><br/><b>Address:</b> Britton and Water St., Rio Grande City<br/><br/><b>County:</b> Starr]]></description>
