    <name>Kilgore Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[<b>Address:</b> 412 Kilgore Road, Goliad<br/><br/><b>County:</b> Goliad]]></description>
    <Point><coordinates>-97.298110,28.769300,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Ramsey Home</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[205 Garden Street, Goliad.<br/><br/><b>Address:</b> 205 E. Garden Street, Goliad<br/><br/><b>County:</b> Goliad<br/><br/><b>Marker Text:</b> No Text]]></description>
    <Point><coordinates>-97.393578,28.672239,0</coordinates></Point>
  </Placemark>
