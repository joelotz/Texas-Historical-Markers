    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 1370 Church Hill Dr., New Braunfels<br/><br/><b>County:</b> Comal<br/><br/><b>Marker Text:</b> marker pending]]></description>
