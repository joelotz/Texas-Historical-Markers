  </Placemark>
  <Placemark>
    <name>Colonel James Clinton Neill</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[Riverside Cemetery, Garcia and Crockett Streets,  Seguin<br/><br/><b>Address:</b> Seguin<br/><br/><b>County:</b> Guadalupe<br/><br/><b>Marker Text:</b> Born in North Carolina in 1790; came to Texas in 1831; participated in the storming and capture of Bexar; December 5 to 10, 1835; wounded April 20, 1836 in the skirmish preceding the Battle of San Jacinto; died about 1845]]></description>
    <Point><coordinates>-97.961809,29.560713,0</coordinates></Point>
  </Placemark>
