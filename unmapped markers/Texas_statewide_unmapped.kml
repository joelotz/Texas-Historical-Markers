    <name>Karl Haas Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[<b>Address:</b> 634 Astral Point, Spring Branch<br/><br/><b>County:</b> Comal<br/><br/><b>Marker Text:</b> Established 1867 Historic Texas Cemetery 2018]]></description>
