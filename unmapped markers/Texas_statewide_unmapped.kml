  </Placemark>
  <Placemark>
    <name>Salem Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[On CR 139, 2 mi. W of int. with FM 585<br/><br/><b>Address:</b> Bangs<br/><br/><b>County:</b> Brown<br/><br/><b>Marker Text:</b> Historic Texas Cemetery - 2005 (HTC medallion only)]]></description>
