    <name>Presbyterians in Brownwood</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 700 Fisk, Brownwood<br/><br/><b>County:</b> Brown<br/><br/><b>Marker Text:</b> marker pending]]></description>
