    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 400 W. Overland Ave., El Paso<br/><br/><b>County:</b> El Paso<br/><br/><b>Marker Text:</b> marker pending]]></description>
