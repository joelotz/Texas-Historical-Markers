  </Placemark>
  <Placemark>
    <name>Leoncita Springs</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[15 mi. N, east of SH 118<br/><br/><b>Address:</b> Alpine<br/><br/><b>County:</b> Brewster<br/><br/><b>Marker Text:</b> First known to history when Juan Dominguez de Mendoza camped here in 1684. Stage stand on the San Antonio to El Paso route through Musquiz Cañon 1857-1883. A camel train commanded by Lieut. W.H. Echols camped here in 1859. Erected by the State of Texas 1936]]></description>
    <Point><coordinates>-103.691671,30.491671,0</coordinates></Point>
  </Placemark>
