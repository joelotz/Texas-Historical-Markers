  <Placemark>
    <name>Aldredge Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 1211 S. FM 706, Lufkin<br/><br/><b>County:</b> Angelina<br/><br/><b>Marker Text:</b> marker pending]]></description>
