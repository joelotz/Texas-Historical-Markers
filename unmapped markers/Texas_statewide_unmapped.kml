  <Placemark>
    <name>McClelland Community Church</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[7 mi. south of Shelbyville, via SH 87 to SH 147 S to McClelland, then east on county road<br/><br/><b>Address:</b> Shelbyville<br/><br/><b>County:</b> Shelby<br/><br/><b>Marker Text:</b> --]]></description>
