  </Placemark>
  <Placemark>
    <name>Rockwall and Brin Church of Christ</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[<b>Address:</b> Terrell<br/><br/><b>County:</b> Kaufman]]></description>
