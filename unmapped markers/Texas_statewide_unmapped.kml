    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 647 E. St. Charles St., Brownsville<br/><br/><b>County:</b> Cameron<br/><br/><b>Marker Text:</b> marker pending]]></description>
