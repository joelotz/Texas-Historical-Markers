  <Placemark>
    <name>William Marsh Rice</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[marker pending<br/><br/><b>Address:</b> 2525 Washington Avenue, Houston<br/><br/><b>County:</b> Harris<br/><br/><b>Marker Text:</b> marker pending]]></description>
