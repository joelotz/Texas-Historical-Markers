    <name>B. B. Goodrich House</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[200 block of Fanthorp St., Anderson.<br/><br/><b>Address:</b> Anderson<br/><br/><b>County:</b> Grimes<br/><br/><b>Marker Text:</b> --]]></description>
