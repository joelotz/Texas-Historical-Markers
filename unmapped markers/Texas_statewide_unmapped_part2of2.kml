    <name>Hammer-McFaddin-Harris Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[<b>Address:</b> 12435 Redbluff Road, Pasadena<br/><br/><b>County:</b> Harris<br/><br/><b>Marker Text:</b> Established in 1851 and designated a Historic Texas Cemetery in 2010.]]></description>
    <Point><coordinates>-95.0483292900318,29.6024366602034,0</coordinates></Point>
  </Placemark>
