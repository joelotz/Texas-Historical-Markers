    <name>World War I and II Memorial</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[northeast corner of Fisher and Laurel, Matagorda<br/><br/><b>County:</b> Matagorda<br/><br/><b>Marker Text:</b> "In memory of Boyd Scott Dunbar Woe Yeamans Joseph Beverly Lawhon World War I-II"]]></description>
    <Point><coordinates>-95.971413,28.689207,0</coordinates></Point>
  </Placemark>
