<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Lamb County — Unmapped Historical Markers</name>
  <description>THC markers in Lamb County without an HMDB id (isMissing excluded). 1 with THC coords; 0 geocoded from address; 3 omitted (no usable address). Orange pins are isPending=True — the marker may not be installed yet.</description>
  <Style id="normal">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/red-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="pending">
    <IconStyle>
      <color>ff00a5ff</color>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/orange-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Placemark>
    <name>Sudan Hotel</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[on 1st Street, between Main &amp; Commerce-Sudan<br/><br/><b>Address:</b> First Street, Sudan<br/><br/><b>Marker Text:</b> --]]></description>
    <Point><coordinates>-102.523106,34.065787,0</coordinates></Point>
  </Placemark>
</Document>
</kml>
