<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Denton County — Unmapped Historical Markers</name>
  <description>THC markers in Denton County without an HMDB id (isMissing excluded). 2 with THC coords; 0 geocoded from address; 2 omitted (no usable address). Orange pins are isPending=True — the marker may not be installed yet.</description>
  <Style id="normal">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/red-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="pending">
    <IconStyle>
      <color>ff00a5ff</color>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/orange-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Placemark>
    <name>Ritter Cemetery</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[<b>Address:</b> Lewisville<br/><br/><b>Marker Text:</b> Established ca. 1860. Historic Texas Cemetery - 2001]]></description>
    <Point><coordinates>-96.9543444439792,33.0650845681763,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>[PENDING] St. John's Community</name>
    <styleUrl>#pending</styleUrl>
    <description><![CDATA[<b>⚠ PENDING — marker may not yet be installed at this location.</b><br/><br/>I drove past several times looking and was unable to spot the marker, indicating it hasn’t been installed yet.<br/><br/><b>Address:</b> FM 455, Pilot Point]]></description>
    <Point><coordinates>-96.95038,33.39027,0</coordinates></Point>
  </Placemark>
</Document>
</kml>
