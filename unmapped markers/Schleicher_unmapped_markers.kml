<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Schleicher County — Unmapped Historical Markers</name>
  <description>THC markers in Schleicher County without an HMDB id (isMissing excluded). 1 with THC coords; 0 geocoded from address; 0 omitted (no usable address). Orange pins are isPending=True — the marker may not be installed yet.</description>
  <Style id="normal">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/red-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="pending">
    <IconStyle>
      <color>ff00a5ff</color>
      <Icon><href>http://maps.google.com/mapfiles/ms/icons/orange-dot.png</href></Icon>
    </IconStyle>
  </Style>
  <Placemark>
    <name>Old Courthouse and Jail</name>
    <styleUrl>#normal</styleUrl>
    <description><![CDATA[On Courthouse grounds at US 190 &amp; 277 intersection , El Dorado<br/><br/><b>Address:</b> US 190 &amp; 277 Intersection, El Dorado, El Dorado]]></description>
    <Point><coordinates>-100.60045,30.85935,0</coordinates></Point>
  </Placemark>
</Document>
</kml>
